# ---------------------------------------------------------------------------
# Pawtopia environment. Copy to .env.local (never commit real values).
# ---------------------------------------------------------------------------

# Supabase project (Dashboard → Project Settings → API). Public, safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only. Used for waitlist tokens, account deletion and the admin bootstrap script.
# NEVER expose this to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Comma-separated emails that become admin automatically on first sign-in.
ADMIN_EMAILS=you@example.com

# Public URL of the app (used in emails and share links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: SMTP for waitlist confirmation emails (Resend, Postmark, SES, SendGrid...).
# Supabase sign-in emails are configured separately in the Supabase dashboard.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Pawtopia <hello@your-domain.com>"
