# ---------------------------------------------------------------------------
# Tiny Wins environment variables. Copy to .env.local and fill in.
# NEXT_PUBLIC_* values are sent to the browser. Everything else stays on the
# server. Never commit real keys.
# ---------------------------------------------------------------------------

# Your site's public URL (used in email links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "anon" public key (or the newer "publishable" key). Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. The "service_role" key (or newer "secret" key). Used for the
# waitlist and account deletion. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Waitlist confirmation emails via Resend (https://resend.com). Required in
# production; in development the confirm link is printed to the console.
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. "Pip <pip@yourdomain.com>"
WAITLIST_FROM_EMAIL=

# Optional: salt for hashing IPs (rate limiting). Any long random string.
WAITLIST_IP_SALT=

# Optional: Cloudflare Turnstile bot check on the waitlist form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: "waitlist" = only confirmed waitlist emails can create accounts.
# Leave empty for open sign-ups.
SIGNUP_MODE=

# Links shown on the site
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@your-handle
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
