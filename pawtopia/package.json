{
  "name": "pawtopia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run src",
    "test:db": "PAWTOPIA_DB_TESTS=1 vitest run tests/db",
    "test:e2e": "playwright test",
    "admin:grant": "node --env-file=.env.local scripts/grant-admin.mjs",
    "stack:start": "bash tests/local-stack/start.sh",
    "stack:reset": "bash tests/local-stack/reset-db.sh"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "nodemailer": "^10.1.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "mailparser": "^3.9.46",
    "pg": "^8.23.1",
    "smtp-server": "^3.20.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
